# ─────────────────────────────────────────────────────────────
# K53 Academy — environment variables
# Copy to .env.local and fill in. The DEMO build runs with none of
# these set; they're only needed when you wire the real backend.
# ─────────────────────────────────────────────────────────────

# Supabase (auth + Postgres + storage)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server only, never expose

# Database (Supabase Postgres — use the pooled URL for the app, direct for migrations)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Paystack (South African payments — cards, EFT, SnapScan)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Cloudinary (road sign images & vehicle diagrams, if you move off SVG)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# Unsplash (hero vehicle imagery)
UNSPLASH_ACCESS_KEY="xxx"

# AI assistant (Robo-Instructor) — OPTIONAL.
# Without this, the assistant answers from the app's own K53 content locally.
# With it, app/api/chat/route.ts uses Claude (claude-opus-4-8), grounded in the
# same content. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:5300"
